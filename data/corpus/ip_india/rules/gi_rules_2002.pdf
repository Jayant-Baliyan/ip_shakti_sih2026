            <wu-machine-translation-widget wt-hide="true" atac-widget-languages="[{&quot;id&quot;:&quot;ar&quot;,&quot;value&quot;:&quot;عربي&quot;},{&quot;id&quot;:&quot;en&quot;,&quot;value&quot;:&quot;English&quot;},{&quot;id&quot;:&quot;es&quot;,&quot;value&quot;:&quot;Español&quot;},{&quot;id&quot;:&quot;fr&quot;,&quot;value&quot;:&quot;Français&quot;},{&quot;id&quot;:&quot;ru&quot;,&quot;value&quot;:&quot;Русский&quot;},{&quot;id&quot;:&quot;zh&quot;,&quot;value&quot;:&quot;中文&quot;}]"
