            <li><a href="/wipolex/en/legislation/details/23139">Statutory Order 3232(E),&nbsp;(Exemption of Crops listed in the Annex I of the International Treaty on Plant Genetic Resources for Food and Agriculture (ITPGRFA) from seeking approval of NBA under Section 3 and 4 of the Biological Diversity Act, 2002)</a>&nbsp;(IN201)</li>
            <li><a href="/wipolex/en/legislation/details/23140">Statutory Order 753(E),&nbsp;(Section 3-7, 18-47, 49-53, 55-58, 60 and 61 of The Biological Diversity Act come in to force)</a>&nbsp;(IN202)</li>
            <li><a href="/wipolex/en/legislation/details/23138">The Guidelines on Access to Biological Resources and Associated Knowledge and Benefits Sharing Regulations, 2014</a>&nbsp;(IN200)</li>
            <li><a href="/wipolex/en/legislation/details/23137">Statutory Order 1911(E),&nbsp;The Guidelines for International Collaboration Research Projects Involving Transfer or Exchange of Biological Resources or Information relating thereto between Institutions including Government Sponsored Institutions and such Institutions in Other Countries</a>&nbsp;(IN199)</li>
            <li><a href="/wipolex/en/legislation/details/7641">Biological Diversity Rules, 2004</a>&nbsp;(IN047)</li>
          </ul>
        </span>
      </wu-field>
    </wu-slot>
  </wu-view-panel>


